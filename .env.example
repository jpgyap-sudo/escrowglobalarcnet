# This project is localhost-only. Copy to .env; never commit .env.
PORT=4173
ESCROW_MODE=sandbox
# Admin authentication is required for the public operator console. Generate a
# scrypt$... hash locally; never put the plaintext password in this file.
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD_HASH=scrypt$32768$8$1$REPLACE_WITH_BASE64_SALT$REPLACE_WITH_BASE64_DERIVED_KEY
# Public admin origin is only needed when nginx proxies the loopback server.
ADMIN_ORIGIN=https://admin.escrowglobal.io
# Get partner TEST credentials from MoonPay. Do not invent currency codes.
MOONPAY_ENV=sandbox
MOONPAY_PUBLIC_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_SOLANA_USDC_CODE=
MOONPAY_SOLANA_USDT_CODE=
# Optional allowlisted HTTPS return URL configured in your provider dashboard.
MOONPAY_RETURN_URL=
# Kept false; local server cannot supply a verified customer public IP for live mode.
ALLOW_LIVE_ONRAMP=false
